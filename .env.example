# Copy to .env.local and fill in. Unless marked "local only", set the same
# variables in Vercel (Project Settings -> Environment Variables) for
# Production and Preview.

# Sanity project (sanity.io/manage). Public: used by the site and the Studio.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Shared secret for the Sanity webhook that refreshes the site on publish
# (src/app/api/revalidate/route.ts). Any long random string; paste the same
# value into the webhook's "Secret" field in sanity.io/manage.
SANITY_REVALIDATE_SECRET=

# Local only -- never add to Vercel. An Editor API token (sanity.io/manage ->
# API -> Tokens), used only by the seed script (npm run seed). Delete the
# token in Sanity once seeding is done.
SANITY_WRITE_TOKEN=
